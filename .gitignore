# Copyrighted game resources (WADs, Daggerfall data, etc.) are never committed.
# Keep the folder itself in source control so people know where to put them.
# Bracketed letters match either casing, for clients that are case-sensitive.
/[Gg]ame[Rr]esources/**
!/[Gg]ame[Rr]esources/.gitkeep

# Doom mods live in their own private backup repo (WadBackups).
/[Gg]ame[Mm]ods/

# Unity-generated logs can contain local machine paths.
/daggerfall-unity-master/[Ll]ogs/

# The current overnight goal is local.
/work/goal.md
/work/questions.md
/work/agent-reports.md
/work/suspectedoversights.md
/work/queue/

__pycache__/
*.pyc
