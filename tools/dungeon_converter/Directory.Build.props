<Project>
  <!-- Keep all build output outside the repository. -->
  <PropertyGroup>
    <DungeonConverterBuildRoot>$(MSBuildThisFileDirectory)..\..\..\DoomDaggerfall-build\dungeon_converter\</DungeonConverterBuildRoot>
    <BaseIntermediateOutputPath>$(DungeonConverterBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(DungeonConverterBuildRoot)bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
