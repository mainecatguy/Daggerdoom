<Project>
  <!-- Keep all build output outside the repository. -->
  <PropertyGroup>
    <ItemGalleryBuildRoot>$(MSBuildThisFileDirectory)..\..\..\DoomDaggerfall-build\item_gallery\</ItemGalleryBuildRoot>
    <BaseIntermediateOutputPath>$(ItemGalleryBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(ItemGalleryBuildRoot)bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
