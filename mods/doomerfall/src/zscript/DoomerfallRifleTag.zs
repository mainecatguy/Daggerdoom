// Doomerfall's rifle tag (todo: rifletag 01), next to the weapon categories in DoomerfallWeaponCategory.zs. Rifles
// will get their own skill later (work/backlog/rifles-skill.md); this tag changes no skill yet.
//
// Owner, 2026-11-26: a rifle is "any ballistic semi-automatic weapon that is not an explosive, energy weapon, shotgun
// or pistol". The DRLA list below is not hand-made: tools/rifle_tag/derive_rifles.py applies that rule to each DRLA
// gun's own DECORATE (ammo type, DRLA type tokens, and the tics between shots on its default fire path) and writes the
// list here. Its --check mode fails if this list and the rule disagree. The rule can't be run here, in the game,
// because ZScript can't see which states fire a shot, and DRLA gives its type tokens only while a gun is held.
//
// Classes are looked up at run time and matched exactly (not subclasses, since each DRLA gun was judged on its own
// data), so the list does nothing without DRLA, and stock Doom has no rifles.
class DoomerfallRifleTag abstract
{
	clearscope static bool IsRifle(Weapon w)
	{
		return w && IsRifleClass(w.GetClass());
	}

	clearscope static bool IsRifleClass(class<Weapon> wc)
	{
		if (!wc) return false;
		static const String rifles[] = {
		// GENERATED by tools/rifle_tag/derive_rifles.py --write. Do not edit by hand.
			"RLAntiMaterielRifle",
			"RLAssaultRifleBattleRifle",
			"RLElephantGun",
			"RLGaussRifle",
			"RLHighPowerMarksmanRifle",
			"RLMarksmanRifle",
			"RLSniperRifle",
			// END GENERATED
			// Doomerfall's own guns. Owner, 2026-11-26: the Light Carbine (todo: lightcarbine 01, not built yet) is
			// a rifle. That card must use this class name or change it here.
			"DoomerfallLightCarbine"
		};
		for (int i = 0; i < rifles.Size(); i++)
		{
			class<Weapon> c = rifles[i]; // Null when that mod is not loaded.
			if (c && wc == c) return true;
		}
		return false;
	}
}
