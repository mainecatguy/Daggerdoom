// The Automatics fire-rate bands (skillperks 09). A gun's band is part of the gun (owner, 2026-11-27): its base tics
// between shots in its primary fire, without mods, perks or other fire-rate bonuses, at full speed for a gun that spins
// up. 4 or more tics is the slow band, 3 the middle band, 1-2 the fast band. Stock Doom's Chaingun fires every 4 tics.
// DRLA's guns come from a table read from DRLA's own DECORATE by tools/automatics/derive_bands.py (--check fails if it
// is stale). Classes are names only, so the table does nothing without DRLA. A gun on neither list has no band.
class DoomerfallAutomaticBands abstract
{
	enum EBand { BandNone, BandSlow, BandMiddle, BandFast }

	clearscope static int BandOf(class<Actor> c)
	{
		int t = TicsOf(c);
		if (t <= 0) return BandNone;
		if (t >= 4) return BandSlow;
		return t == 3 ? BandMiddle : BandFast;
	}

	// The base tics between shots of a gun class: its own entry, else its nearest listed parent's. 0 when unknown.
	clearscope static int TicsOf(class<Actor> c)
	{
		// GENERATED by tools/automatics/derive_bands.py --write. Do not edit by hand.
		static const String names[] = {
			"RLAssaultRifleChaingun",
			"RLAssaultRifleMinigun",
			"RLAssaultRifleUzi",
			"RLAutocannon",
			"RLAutoDoubleShotgun",
			"RLAutoshotgun",
			"RLBattleRifle",
			"RLBFG10K",
			"RLBulletstormChaingun",
			"RLBulletstormRifle",
			"RLBurstCannonBattleRifle",
			"RLBurstCannonChaingun",
			"RLBurstCannonLaserRifle",
			"RLBurstCannonMinigun",
			"RLBurstCannonNuclearPlasmaRifle",
			"RLBurstCannonPlasmaRifle",
			"RLBurstCannonUzi",
			"RLChaingun",
			"RLChameleonRifle",
			"RLDemolitionAmmoBattleRifle",
			"RLDemolitionAmmoChaingun",
			"RLDemolitionAmmoMinigun",
			"RLDemolitionAmmoUzi",
			"RLEnergysaw",
			"RLFlamethrower",
			"RLGatlingGun",
			"RLGrammatonClericBeretta",
			"RLHighPowerBattleRifle",
			"RLHighPowerChaingun",
			"RLHighPowerLaserRifle",
			"RLHighPowerMarksmanRifle",
			"RLHighPowerMinigun",
			"RLHighPowerNuclearPlasmaRifle",
			"RLHighPowerPlasmaRifle",
			"RLHighPowerRCP90",
			"RLHighPowerThompson",
			"RLHighPowerUzi",
			"RLHighPowerVanguardRifle",
			"RLHurricaneCannon",
			"RLHyperBlaster",
			"RLLaserMinigun",
			"RLLaserRifle",
			"RLMarathonAssaultRifle",
			"RLMarksmanRifle",
			"RLMinigun",
			"RLNanomachicArmamentGenerator",
			"RLNanoManufactureAmmoUzi",
			"RLNuclearPlasmaRifle",
			"RLPlasmaRifle",
			"RLPlasmaUzi",
			"RLRCP90",
			"RLSoulstormRifle",
			"RLStealthRifle",
			"RLSuperMachinegun",
			"RLThompson",
			"RLUzi",
			"RLVanguardRifle",
			"RLWidowmakerSMG",
			""
		};
		static const int tics[] = {
			37,
			1,
			27,
			13,
			8,
			6,
			4,
			6,
			4,
			4,
			2,
			2,
			2,
			1,
			2,
			2,
			1,
			4,
			4,
			4,
			4,
			1,
			3,
			1,
			1,
			4,
			28,
			4,
			4,
			3,
			8,
			1,
			3,
			3,
			3,
			2,
			3,
			4,
			6,
			3,
			1,
			3,
			2,
			7,
			1,
			3,
			3,
			3,
			3,
			3,
			3,
			4,
			4,
			4,
			2,
			3,
			4,
			2,
			0
		};
		// END GENERATED
		for (class<Actor> k = c; k; k = (class<Actor>)(k.GetParentClass()))
		{
			if (k == "Chaingun") return 4; // CHGG A 4 A_FireCGun, CHGG B 4 A_FireCGun
			Name n = k.GetClassName();
			for (int i = 0; i < names.Size() - 1; i++)
				if (n == Name(names[i])) return tics[i];
		}
		return 0;
	}
}
