		// END GENERATED
		for (class<Actor> k = c; k; k = (class<Actor>)(k.GetParentClass()))
		{
			if (k == "Chaingun") return 4; // CHGG A 4 A_FireCGun, CHGG B 4 A_FireCGun
			Name n = k.GetClassName();
			int primary = 0, altTics = 0;
			for (int i = 0; i < names.Size() - 1; i++)
			{
				if (n != Name(names[i])) continue;
				if (modes[i] != "")
				{
					class<Inventory> mode = modes[i];
					let item = holder && mode ? holder.FindInventory(mode) : null;
					if ((item ? item.Amount : 0) != counts[i]) continue;
				}
				if (alts[i]) altTics = tics[i];
				else if (!primary) primary = tics[i];
			}
			if (alt && altTics) return altTics;
			if (primary) return primary;
		}
		return 0;
